{
  "name": "icd-10-cm-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for @lowlysre/icd-10-cm and @lowlysre/icd-10-cm-es",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && npm run test:repo",
    "test:coverage": "npm run test:coverage --workspaces && npm run test:repo",
    "test:repo": "npm run build --silent && node --experimental-strip-types --test \"tests/*.test.ts\"",
    "lint": "oxlint . && prettier --check .",
    "parse-icd": "node --experimental-strip-types scripts/parseICD.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "John McCall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlysre/icd-10-cm.git"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.3.2",
    "typescript": "^7.0.2"
  }
}
