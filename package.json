{
  "name": "@lowlysre/icd-10-cm",
  "version": "3.0.0",
  "description": "FY2027 ICD-10-CM diagnosis codes and descriptions (CDC/NCHS, effective October 1, 2026) with TypeScript types and zero dependencies",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "test": "npm run build --silent && node --test",
    "lint": "oxlint . && prettier --check .",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc --project tsconfig.json",
    "parse-icd": "node --experimental-strip-types scripts/parseICD.ts",
    "test:coverage": "npm run build --silent && node --test --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "John McCall",
  "license": "MIT",
  "files": [
    "dist",
    "data"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlysre/icd-10-cm.git"
  },
  "homepage": "https://github.com/lowlysre/icd-10-cm#readme",
  "bugs": {
    "url": "https://github.com/lowlysre/icd-10-cm/issues"
  },
  "keywords": [
    "icd",
    "icd-10",
    "icd-code",
    "icd10",
    "icd-10-cm",
    "icd10cm",
    "icd-10-cm-codes",
    "diagnosis",
    "diagnosis-codes",
    "medical",
    "medical-coding",
    "medical-billing",
    "healthcare",
    "health-data",
    "cdc",
    "nchs",
    "cms",
    "fhir",
    "fy2027",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.3.2",
    "typescript": "^7.0.2"
  }
}
