{
  "name": "@lowlysre/icd-10-cm-es",
  "version": "0.0.0-development",
  "description": "CIE-10-ES Spanish descriptions for ICD-10-CM diagnosis codes (Ministerio de Sanidad, 6th edition, 2026) with TypeScript types and zero dependencies",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "test": "npm run build --silent && node --test",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc --project tsconfig.json",
    "test:coverage": "npm run build --silent && node --test --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/cie10es.min.json": "./data/cie10es.min.json",
    "./data/not-in-icd10cm.min.json": "./data/not-in-icd10cm.min.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "John McCall",
  "license": "MIT",
  "files": [
    "dist",
    "data"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlysre/icd-10-cm.git",
    "directory": "packages/icd-10-cm-es"
  },
  "homepage": "https://github.com/lowlysre/icd-10-cm/tree/main/packages/icd-10-cm-es#readme",
  "bugs": {
    "url": "https://github.com/lowlysre/icd-10-cm/issues"
  },
  "keywords": [
    "icd",
    "icd-10",
    "icd10",
    "icd-10-cm",
    "icd10cm",
    "cie-10",
    "cie10",
    "cie-10-es",
    "cie10es",
    "spanish",
    "español",
    "diagnosis",
    "diagnosis-codes",
    "diagnósticos",
    "medical",
    "medical-coding",
    "healthcare",
    "health-data",
    "i18n",
    "translation",
    "offline",
    "typescript"
  ]
}
